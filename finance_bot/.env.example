# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-with-your-token
# Необязательно: путь к файлу базы данных
DB_PATH=finance.db
# Необязательно: ID пользователей Telegram через запятую, которым разрешён доступ.
# Пусто — бот отвечает всем (данные общие для всех пользователей!).
ALLOWED_USER_IDS=
# Google Sheets (необязательно): название таблицы, расшаренной на сервисный аккаунт
GOOGLE_SPREADSHEET_NAME=Finance Bot
# Необязательно: путь к ключу сервисного аккаунта (по умолчанию credentials.json рядом с bot.py)
GOOGLE_CREDENTIALS_FILE=
# Совет от нейросети для /advice (необязательно). Ключ: Google AI Studio -> Get API key.
# В Gemini уходят только суммы по категориям, без названий магазинов и имён.
GEMINI_API_KEY=
# Необязательно: модель (по умолчанию gemini-2.5-flash)
GEMINI_MODEL=
